rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The authenticated owner can access their root account document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // All libraries and library-owned subcollections remain isolated below
      // the same authenticated user document.
      match /{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // System & Global collections
    match /system/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /appUpdate/{document=**} {
      allow read, write: if true;
    }
  }
}
